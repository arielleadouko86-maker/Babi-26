<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BABI 26 - Jeu de Foot</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon-512.png">
<style>
*{box-sizing:border-box} body{margin:0;font-family:Arial,sans-serif;background:#0a7a42;color:white;text-align:center;min-height:100vh}
header{padding:20px 10px} h1{font-size:42px;margin:5px} h1 span{color:#ffd700} p{opacity:.9}
.card{background:white;color:#111;margin:15px auto;max-width:420px;border-radius:20px;padding:20px;box-shadow:0 10px 30px rgba(0,0,0,.3)}
.score{font-size:22px;font-weight:bold} .score b{color:#0a7a42;font-size:32px}
.goal{font-size:80px;margin:10px} .buttons{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:15px}
button{border:none;border-radius:12px;padding:14px 18px;font-size:18px;font-weight:bold;cursor:pointer}
.btn-gauche{background:#ffcc00} .btn-centre{background:#111;color:white} .btn-droite{background:#ff6b00;color:white}
.btn-rejouer{background:#0a7a42;color:white;width:100%;margin-top:15px}
#msg{font-size:20px;font-weight:bold;min-height:30px;margin-top:12px}
small{opacity:.7}
</style>
</head>
<body>
<header>
<h1>BABI <span>26</span> ⚽</h1>
<p>Le jeu de foot d'Abidjan ! Marque un max de buts !</p>
</header>
<div class="card">
<div class="score">Score : <b id="score">0</b> / Essai : <b id="essai">1</b> / 5</div>
<div class="goal" id="goal">🥅</div>
<div id="msg">Choisis où tirer !</div>
<div class="buttons">
<button class="btn-gauche" onclick="tirer('gauche')">⬅️ Gauche</button>
<button class="btn-centre" onclick="tirer('centre')">⬆️ Centre</button>
<button class="btn-droite" onclick="tirer('droite')">➡️ Droite</button>
</div>
<button class="btn-rejouer" onclick="recommencer()">🔄 Rejouer</button>
</div>
<p><small>BABI 26 - Bouaké • Abidjan • Made with ❤️</small></p>
<script>
let score=0, essai=1;
function tirer(choix){
 if(essai>5) return;
 let gardien=['gauche','centre','droite'][Math.floor(Math.random()*3)];
 let msg=document.getElementById('msg');
 let goal=document.getElementById('goal');
 if(choix===gardien){ goal.textContent='🧤'; msg.textContent='Arrêté ! Le gardien a plongé du bon côté !'; msg.style.color='red'; }
 else { score++; goal.textContent='⚽🎉'; msg.textContent='GOOOAL ! BABI 26 !'; msg.style.color='green'; }
 document.getElementById('score').textContent=score;
 if(essai===5){
   setTimeout(()=>{
     if(score>=3) msg.textContent='🏆 CHAMPION ! Tu as marqué '+score+'/5 !';
     else msg.textContent='Fin du match : '+score+'/5. Rejoue pour devenir champion !';
     goal.textContent='🏆';
   },600);
 }
 essai++;
 if(essai<=5) document.getElementById('essai').textContent=essai;
 else document.getElementById('essai').textContent='5';
}
function recommencer(){ score=0; essai=1; document.getElementById('score').textContent='0'; document.getElementById('essai').textContent='1'; document.getElementById('msg').textContent='Choisis où tirer !'; document.getElementById('msg').style.color='black'; document.getElementById('goal').textContent='🥅'; }
</script>
</body>
</html>
