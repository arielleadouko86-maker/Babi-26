<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BABI 26 - Saison 2026/27</title>
<link rel="manifest" href="manifest.json">
<style>
*{box-sizing:border-box} body{font-family:Arial,sans-serif;background:#0a0a0a;color:white;text-align:center;padding:10px;margin:0}
h1{font-size:26px;margin:8px 0} h2{font-size:19px;margin:8px 0}
.card{background:#1a4a1a;border-radius:15px;padding:14px;margin:10px 0;display:none}
.card.active{display:block}
button{border:none;padding:11px;border-radius:10px;font-weight:bold;margin:4px;width:92%;cursor:pointer;font-size:14px}
.gold{background:linear-gradient(135deg,#FFD700,#ff6d00);color:black}.blue{background:#2196F3;color:white}.purple{background:#9b30ff;color:white}.red{background:#ff3b30;color:white}.green{background:#00c853;color:white}.dark{background:#222;color:white}.orange{background:#ff6d00;color:white}
select,input{width:92%;padding:11px;border-radius:10px;background:#222;color:white;border:2px solid #FFD700;margin:5px 0;text-align:center;font-weight:bold}
.club-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.club-btn{background:#222;border:2px solid #333;border-radius:12px;padding:10px;cursor:pointer;color:white}
.club-btn.selected{border-color:#FFD700;background:#333;transform:scale(1.03)}
.var-screen{background:#000;border:4px solid #ff0000;border-radius:15px;padding:14px;margin:10px 0;display:none}
.var-screen.active{display:block}
.controller-efoot{display:flex;justify-content:space-between;align-items:center;background:#0f0f0f;border-radius:25px;padding:16px;margin:12px 0;border:3px solid #333}
.stick{width:105px;height:105px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#555,#111);border:3px solid #777;display:flex;align-items:center;justify-content:center}
.stick-knob{width:52px;height:52px;border-radius:50%;background:radial-gradient(circle at 30% 30%,#888,#222);display:flex;align-items:center;justify-content:center;font-size:22px}
.buttons-zone{width:185px;height:145px;position:relative}
.efoot-btn{position:absolute;width:54px;height:54px;border-radius:50%;border:3px solid white;font-weight:900;font-size:10px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.1}
.btn-A{bottom:0;left:65px;background:#2196F3;color:white}
.btn-B{right:0;top:48px;background:#ff3b30;color:white;width:64px;height:64px}
.btn-Y{top:0;left:65px;background:#FFD700;color:black}
.btn-X{left:0;top:48px;background:#00c853;color:white}
.friend-card{background:#222;border-radius:12px;padding:10px;margin:8px 0;display:flex;justify-content:space-between;align-items:center;text-align:left}
table{width:100%;border-collapse:collapse;background:#0a2e0a;border-radius:10px;overflow:hidden} th,td{padding:8px;font-size:13px;border-bottom:1px solid #333}
.comment-box{background:#000;border:2px solid #FFD700;border-radius:12px;padding:10px;margin:8px 0;text-align:left}
</style>
</head>
<body>
<h1>⚽ BABI 26</h1>
<p style="margin:0">Saison 2026/27 - Abidjan 🇨🇮 | SANS BUG - SANS VIRUS - 100% Sûr</p>
<p>💰 <b id="coins">0</b> Pièces | Club: <b id="myClub">REAL MADRID</b> | Division: <b id="myDiv">Division 10</b> | <b id="myPoints">0</b> pts | En ligne: <b id="onlineWins">0</b> victoires</p>
<p>🏟️ <span id="myStadeTxt">Bernabéu</span> - 🎵 <span id="myChantTxt">Hala Madrid !</span> | 🟢 <b id="onlineCount">1 247</b> joueurs en ligne | 🔒 SANS VIRUS</p>

<div id="menu" class="card active">
<h2>🎮 MENU PRINCIPAL - BABI 26</h2>
<button class="gold" onclick="showMode('clubs')">🌍 CLUBS - Choisir ton club 2026/27</button>
<button class="blue" onclick="showMode('match')">⚽ MATCH RAPIDE - Hors-ligne</button>
<button class="purple" onclick="showMode('online')">🌍 JOUER EN LIGNE - 1v1</button>
<button class="orange" onclick="showMode('tournament')">🏆 TOURNOI DU WEEK-END EN LIGNE - +200 Pièces</button>
<button class="green" onclick="showMode('friends')">👥 AMIS - Abidjan</button>
<button class="dark" onclick="showMode('ranking')">📊 CLASSEMENT - Division 10 -> 1</button>
<button class="gold" onclick="showMode('gold')">👑 CARTES DORÉES - DROGBA, MBAPPÉ, PELÉ</button>
<button class="blue" onclick="showMode('defis')">🎯 DÉFIS DU JOUR - 2 défis = 50 Pièces</button>
<p id="msg">Bienvenue à BABI 26 ! SANS BUG, SANS VIRUS, 100% Sûr !</p>
<p style="font-size:12px">Manette : A=PASSE, B=TIR, Y=PROF., X=CENTRE | VAR active | 🎙️ Commentateurs : Jean-Marc ADOU + Koffi BEN</p>
</div>

<div id="clubs" class="card">
<h2>🌍 CLUBS 2026/27</h2><button class="dark" onclick="backMenu()">⬅️ Retour</button>
<p><b>LIGUE 1 IVOIRIENNE 🇨🇮</b></p>
<div class="club-grid">
<button class="club-btn" onclick="selectClub('ASEC MIMOSAS','Stade Félix Houphouët-Boigny','Allez Mimosas !',this)">🟡⚫<br><b>ASEC MIMOSAS</b></button>
<button class="club-btn" onclick="selectClub('AFRICA SPORTS','Stade Robert Champroux','Africa, Africa !',this)">🟢🔴<br><b>AFRICA SPORTS</b></button>
<button class="club-btn" onclick="selectClub('FC SAN PEDRO','Stade Laurent Pokou','San Pedro, on est là !',this)">🔵🟠<br><b>FC SAN PEDRO</b></button>
<button class="club-btn" onclick="selectClub('STADE ABIDJAN','Félicia','Stade, Stade !',this)">⚪🔴<br><b>STADE D'ABIDJAN</b></button>
</div>
<p><b>ESPAGNE 🇪🇸</b></p>
<div class="club-grid">
<button class="club-btn" onclick="selectClub('REAL MADRID','Bernabéu','Hala Madrid !',this)">⚪<br><b>REAL MADRID</b></button>
<button class="club-btn" onclick="selectClub('FC BARCELONE','Camp Nou','Visca Barça !',this)">🔵🔴<br><b>FC BARCELONE</b></button>
</div>
<p><b>ANGLETERRE</b></p>
<div class="club-grid">
<button class="club-btn" onclick="selectClub('ARSENAL','Emirates','Come on Arsenal !',this)">🔴⚪<br><b>ARSENAL</b></button>
<button class="club-btn" onclick="selectClub('MAN CITY','Etihad','Blue Moon !',this)">🩵<br><b>MAN CITY</b></button>
<button class="club-btn" onclick="selectClub('LIVERPOOL','Anfield','You\'ll Never Walk Alone !',this)">🔴<br><b>LIVERPOOL</b></button>
<button class="club-btn" onclick="selectClub('CHELSEA','Stamford Bridge','Blue is the colour !',this)">🔵<br><b>CHELSEA</b></button>
</div>
<p><b>FRANCE 🇫🇷</b></p>
<div class="club-grid">
<button class="club-btn" onclick="selectClub('PSG','Parc des Princes','Ici c\'est Paris !',this)">🔵🔴<br><b>PSG</b></button>
<button class="club-btn" onclick="selectClub('OM','Vélodrome','Allez l\'OM !',this)">⚪🩵<br><b>OM</b></button>
</div>
<p><b>ALLEMAGNE 🇩🇪</b></p>
<div class="club-grid">
<button class="club-btn" onclick="selectClub('BAYERN','Allianz Arena','Mia San Mia !',this)">🔴<br><b>BAYERN</b></button>
</div>
<p id="clubMsg">Ton club : REAL MADRID - Bernabéu - Hala Madrid !</p>
</div>

<div id="match" class="card">
<h2>⚽ MATCH - <span id="mYou">REAL MADRID</span> vs <span id="mAdv">FC BARCELONE</span></h2>
<button class="dark" onclick="backMenu()">⬅️ Retour</button>
<p>🏟️ <span id="mStade">Bernabéu</span> - 🎵 <span id="mChant">Hala Madrid !</span></p>
<select id="advSelect" onchange="changeAdv()"><option>FC BARCELONE</option><option>PSG</option><option>MAN CITY</option><option>ASEC MIMOSAS</option><option>AFRICA SPORTS</option><option>ARSENAL</option><option>LIVERPOOL</option><option>OM</option><option>BAYERN</option><option>CHELSEA</option></select>
<p>⏱️ <b id="timer">05:00</b> | Score: <b id="score">0 - 0</b></p>
<p id="event" style="font-weight:bold">Coup d'envoi !</p>
<div class="comment-box">
<p style="margin:0;font-size:13px;color:#FFD700">🎙️ EN DIRECT :</p>
<p id="commentator" style="margin:5px 0;font-size:14px;font-weight:bold">🎙️ Jean-Marc ADOU : "Bonsoir Abidjan ! Bienvenue à BABI 26 !"</p>
<p id="commentator2" style="margin:0;font-size:12px;color:#ccc">🎙️ Koffi BEN : "On attend un grand match !"</p>
<button class="dark" style="width:auto;padding:6px 12px;font-size:12px" onclick="toggleComment()">🔊 COMMENTATEUR : ON / OFF</button>
</div>
<div id="varScreen1" class="var-screen"><h2 style="color:#ff0000">⚖️ VAR - VÉRIFICATION...</h2><p style="font-size:50px">📺</p><p id="varCheck1">Vérification...</p><p id="varResult1"></p></div>
<p id="celeZone" style="font-size:45px">⚽</p><p id="celeText"></p>
<h3>🎮 TA MANETTE</h3>
<div class="controller-efoot">
<div style="text-align:center"><div class="stick"><div class="stick-knob" id="stickKnob">🕹️</div></div><p style="font-size:11px">STICK<br><span id="stickDir">• Neutre</span><br><button class="dark" style="width:55px;padding:5px" onclick="moveStick('⬅️')">◀️</button><button class="dark" style="width:55px;padding:5px" onclick="moveStick('➡️')">▶️</button></p></div>
<div class="buttons-zone">
<button class="efoot-btn btn-Y" onclick="pressBtn('PROFONDEUR')">Y<br>PROF.</button>
<button class="efoot-btn btn-X" onclick="pressBtn('CENTRE')">X<br>CENTRE</button>
<button class="efoot-btn btn-B" onclick="pressBtn('TIR')">B<br>TIR</button>
<button class="efoot-btn btn-A" onclick="pressBtn('PASSE')">A<br>PASSE</button>
</div>
</div>
<p id="controllerMsg">A=PASSE, B=TIR, Y=PROF., X=CENTRE</p>
<button class="gold" onclick="playAction()">⚽ JOUER L'ACTION (VAR + Commentateur)</button>
<button class="blue" onclick="simulateMatch()">▶️ SIMULER LE MATCH</button>
<p id="matchMsg">Match hors-ligne !</p>
</div>

<div id="online" class="card">
<h2>🌍 EN LIGNE - 1v1</h2><button class="dark" onclick="backMenu()">⬅️ Retour</button>
<p>Ton club: <b id="onlineClub">REAL MADRID</b></p>
<button class="gold" onclick="createRoom()">➕ CRÉER UNE SALLE</button>
<div id="roomCreated" style="display:none;background:#222;border-radius:12px;padding:12px;margin:8px 0">
<p>CODE: <b id="roomCode" style="font-size:28px;color:#FFD700">BABI-0000</b></p>
<button class="blue" onclick="copyCode()">📋 COPIER LE CODE</button>
<p id="waitingFriend">⏳ En attente...</p>
<button class="green" onclick="friendJoins()">👥 SIMULER : Mon ami a rejoint !</button>
</div>
<input id="joinCodeInput" placeholder="Code de ton ami, ex: BABI-4829">
<button class="blue" onclick="joinRoom()">🔗 REJOINDRE AVEC LE CODE</button>
<button class="purple" onclick="quickMatch()">⚡ MATCH RAPIDE</button>
<p id="onlineMsg">Crée une salle ou rejoins avec un code !</p>
</div>

<div id="onlineMatch" class="card">
<h2>🌍 MATCH EN LIGNE - <span id="oYou">REAL MADRID (TOI)</span> vs <span id="oAdv">FC BARCELONE (AMI)</span></h2>
<p>🏟️ <span id="oStade">Bernabéu</span> - 🎵 <span id="oChant">Hala Madrid !</span> - <span id="oDiv">Division 10</span></p>
<p>⏱️ <b id="oTimer">05:00</b> | Score: <b id="oScore">0 - 0</b> | Ping: <b id="ping">23ms</b> 🟢</p>
<p id="oEvent" style="font-weight:bold">Coup d'envoi en ligne !</p>
<div class="comment-box">
<p style="margin:0;font-size:13px;color:#FFD700">🎙️ EN DIRECT - EN LIGNE :</p>
<p id="commentatorOnline" style="margin:5px 0;font-size:14px;font-weight:bold">🎙️ Jean-Marc ADOU : "On est en ligne !"</p>
<p id="commentatorOnline2" style="margin:0;font-size:12px;color:#ccc">🎙️ Koffi BEN : "Que le meilleur gagne !"</p>
</div>
<div id="varScreen" class="var-screen"><h2 style="color:#ff0000">⚖️ VAR EN LIGNE</h2><p style="font-size:50px">📺</p><p id="varCheckText">Vérification...</p><p id="varResult"></p></div>
<p id="oCeleZone" style="font-size:45px">⚽</p><p id="oCeleText"></p>
<div class="controller-efoot">
<div style="text-align:center"><div class="stick"><div class="stick-knob">🕹️</div></div><p style="font-size:11px">STICK</p></div>
<div class="buttons-zone">
<button class="efoot-btn btn-Y" onclick="pressOnline('PROFONDEUR')">Y<br>PROF.</button>
<button class="efoot-btn btn-X" onclick="pressOnline('CENTRE')">X<br>CENTRE</button>
<button class="efoot-btn btn-B" onclick="pressOnline('TIR')">B<br>TIR</button>
<button class="efoot-btn btn-A" onclick="pressOnline('PASSE')">A<br>PASSE</button>
</div>
</div>
<button class="gold" onclick="playOnlineAction()">⚽ JOUER L'ACTION EN LIGNE</button>
<button class="blue" onclick="simulateOnlineMatch()">▶️ SIMULER LE MATCH EN LIGNE</button>
<p id="onlineMatchMsg">Match en ligne 1v1 !</p>
<button class="red" onclick="quitOnlineMatch()">❌ QUITTER</button>
</div>

<div id="tournament" class="card">
<h2>🏆 TOURNOI DU WEEK-END</h2><button class="dark" onclick="backMenu()">⬅️ Retour</button>
<p>Gagnant = <b>+200 Pièces</b> | Ton tour: <b id="tournRound">1/8 Finale</b></p>
<p>🏆 1/8 Finale: TOI vs Koffi - <button class="green" onclick="playTournament()">JOUER 1/8</button></p>
<p id="tournMsg">Gagne le tournoi pour +200 Pièces !</p>
</div>

<div id="friends" class="card">
<h2>👥 AMIS</h2><button class="dark" onclick="backMenu()">⬅️ Retour</button>
<input id="friendName" placeholder="Pseudo, ex: Koffi_225">
<button class="green" onclick="addFriend()">➕ AJOUTER UN AMI</button>
<div id="friendsList"></div>
<p id="friendsMsg">Ajoute tes amis !</p>
</div>

<div id="ranking" class="card">
<h2>📊 CLASSEMENT</h2><button class="dark" onclick="backMenu()">⬅️ Retour</button>
<p>Toi: <b id="rankYou">Division 10 - 0 pts</b></p>
<table><tr><th>Joueur</th><th>Division</th><th>Pts</th><th>Victoires</th></tr><tbody id="rankTable"></tbody></table>
</div>

<div id="gold" class="card">
<h2>👑 CARTES DORÉES</h2><button class="dark" onclick="backMenu()">⬅️ Retour</button>
<p>Tes pièces: <b id="coins2">0</b></p>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
<div style="background:linear-gradient(135deg,#FFD700,#ff6d00);color:black;border-radius:12px;padding:10px"><b>DIDIER DROGBA 🇨🇮</b><br>99 - 15 000 Pièces<br><button class="dark" onclick="buyCard('DROGBA',15000)">ACHETER</button></div>
<div style="background:linear-gradient(135deg,#FFD700,#ff6d00);color:black;border-radius:12px;padding:10px"><b>KYLIAN MBAPPÉ</b><br>98 - 20 000 Pièces<br><button class="dark" onclick="buyCard('MBAPPÉ',20000)">ACHETER</button></div>
<div style="background:linear-gradient(135deg,#FFD700,#ff6d00);color:black;border-radius:12px;padding:10px"><b>PELÉ</b><br>100 - 50 000 Pièces<br><button class="dark" onclick="buyCard('PELÉ',50000)">ACHETER</button></div>
<div style="background:linear-gradient(135deg,#FFD700,#ff6d00);color:black;border-radius:12px;padding:10px"><b>YAYA TOURÉ 🇨🇮</b><br>97 - 12 000 Pièces<br><button class="dark" onclick="buyCard('YAYA TOURÉ',12000)">ACHETER</button></div>
</div>
<p id="goldMsg">Débloque les légendes !</p>
</div>

<div id="defis" class="card">
<h2>🎯 DÉFIS DU JOUR</h2><button class="dark" onclick="backMenu()">⬅️ Retour</button>
<p>🎯 Défi 1 : Marque 3 buts - <b>25 Pièces</b> <button class="green" onclick="doDefi(1,25)">FAIRE DÉFI 1</button> <span id="defi1State">⏳</span></p>
<p>🎯 Défi 2 : Gagne 1 match - <b>25 Pièces</b> <button class="green" onclick="doDefi(2,25)">FAIRE DÉFI 2</button> <span id="defi2State">⏳</span></p>
<p>🏆 Compétition = <b>200 Pièces</b> <button class="gold" onclick="winCompetition()">GAGNER +200</button></p>
<p id="defiMsg">Fais tes 2 défis pour +50 Pièces !</p>
</div>

<script>
// BABI 26 - VERSION SÉCURISÉE SANS BUG - AUCUN VIRUS - AUCUN LIEN EXTERNE - AUCUN TÉLÉCHARGEMENT
function safeSet(id,txt){var el=document.getElementById(id); if(el) el.innerText=txt;}
let coins=0,myClub="REAL MADRID",myStade="Bernabéu",myChant="Hala Madrid !",myDiv=10,myPoints=0,onlineWins=0,scoreYou=0,scoreAdv=0,tournRound=1,varBusy=false;
let friendsList=[{name:"Koffi_225",club:"FC BARCELONE",div:10,pts:45,online:true},{name:"Aya_CIV",club:"ASEC MIMOSAS",div:9,pts:120,online:true},{name:"Yao_Abidjan",club:"PSG",div:10,pts:20,online:false},{name:"Mariam_225",club:"MAN CITY",div:8,pts:210,online:true}];
let roomCode=""; let commentOn=true;
function toggleComment(){commentOn=!commentOn; alert(commentOn?"🎙️ Commentateurs : ON":"🔇 Commentateurs : OFF");}
function commentate(text,who){
if(!commentOn) return;
try{
safeSet('commentator','🎙️ '+who+' : "'+text+'"');
let reactions=["Oh la la, quel geste !","C'est incroyable !","Il a tout compris !","Abidjan est debout !","C'est du grand art !"];
safeSet('commentator2','🎙️ Koffi BEN : "'+reactions[Math.floor(Math.random()*reactions.length)]+'"');
safeSet('commentatorOnline','🎙️ '+who+' : "'+text+'"');
}catch(e){}
}
function commentateGoal(){let goals=["BUUUUUUT !!!!! ABIDJAN EST DEBOUT !!!","ET LE BUUUUT ! QUEL FRAPPE !","BUUUUT ! C'EST MAGNIFIQUE ! MBAPPÉ BRAS CROISÉS !","GOOOOAL ! FOLIE AU STADE FÉLIX HOUPHOUËT-BOIGNY !"]; commentate(goals[Math.floor(Math.random()*goals.length)],"Jean-Marc ADOU");}
function commentateVAR(){commentate("On attend la VAR... L'arbitre regarde la télé... C'est insoutenable !","Jean-Marc ADOU");}
function showMode(id){try{document.querySelectorAll('.card').forEach(c=>c.classList.remove('active'));var el=document.getElementById(id); if(el) el.classList.add('active'); if(id=='friends')renderFriends(); if(id=='ranking')renderRanking(); if(id=='match'){safeSet('mYou',myClub);safeSet('mStade',myStade);safeSet('mChant',myChant);} if(id=='online'){safeSet('onlineClub',myClub);}}catch(e){}}
function backMenu(){document.querySelectorAll('.card').forEach(c=>c.classList.remove('active'));document.getElementById('menu').classList.add('active');}
function selectClub(club,stade,chant,btn){try{myClub=club;myStade=stade;myChant=chant; safeSet('myClub',club); safeSet('myStadeTxt',stade); safeSet('myChantTxt',myChant); safeSet('clubMsg','✅ Ton club : '+club+' - '+stade+' - '+chant); safeSet('msg','✅ Tu as choisi '+club+' ! '+chant); document.querySelectorAll('.club-btn').forEach(b=>b.classList.remove('selected')); if(btn) btn.classList.add('selected'); commentate("Il a choisi "+club+" ! Quel choix !","Jean-Marc ADOU");}catch(e){}}
function changeAdv(){var s=document.getElementById('advSelect'); if(!s) return; safeSet('mAdv',s.value); commentate("L'adversaire sera "+s.value+" !","Jean-Marc ADOU");}
function moveStick(dir){safeSet('stickDir',dir); safeSet('stickKnob',dir); setTimeout(()=>{safeSet('stickKnob','🕹️'); safeSet('stickDir','• Neutre');},600);}
function pressBtn(btn){try{safeSet('controllerMsg','🎮 '+btn); if(btn=='PASSE') commentate("Belle passe ! Il fait tourner !","Jean-Marc ADOU"); if(btn=='CENTRE') commentate("Le centre ! Dans la surface !","Jean-Marc ADOU"); if(btn=='PROFONDEUR') commentate("Passe en profondeur ! Bien joué !","Jean-Marc ADOU"); if(btn=='TIR') playAction();}catch(e){}}
function startVAR(type,online){
if(varBusy) return; varBusy=true;
try{
let el=document.getElementById(online?'varScreen':'varScreen1'); if(el) el.classList.add('active');
safeSet(online?'varCheckText':'varCheck1','VAR - Vérification : '+type+'...');
safeSet(online?'varResult':'varResult1',''); commentateVAR();
setTimeout(()=>{
try{
let ok=Math.random()>0.3;
if(type.indexOf("BUT")>=0){
if(ok){ scoreYou++; if(online){safeSet('oScore',scoreYou+' - '+scoreAdv); safeSet('oEvent','⚽ BUUUUT ! VAR confirme !'); safeSet('oCeleZone','❌'); safeSet('oCeleText','BUUUUT ! MBAPPÉ bras croisés !');} else {safeSet('score',scoreYou+' - '+scoreAdv); safeSet('event','⚽ BUUUUT ! VAR confirme !'); safeSet('celeZone','❌'); safeSet('celeText','BUUUUT ! MBAPPÉ bras croisés !');} safeSet(online?'varResult':'varResult1','✅ BUT ACCORDÉ !'); commentateGoal();
} else { safeSet(online?'varResult':'varResult1','❌ BUT REFUSÉ - HORS-JEU !'); if(online) safeSet('oEvent','❌ BUT REFUSÉ - HORS-JEU !'); else safeSet('event','❌ BUT REFUSÉ - HORS-JEU !'); commentate("HORS-JEU ! Il était hors-jeu de 10 centimètres !","Jean-Marc ADOU");}
} else if(type.indexOf("PENALTY")>=0){
if(ok){ scoreYou++; if(online){safeSet('oScore',scoreYou+' - '+scoreAdv); safeSet('oEvent','⚖️ PENALTY ! VAR confirme !');} else {safeSet('score',scoreYou+' - '+scoreAdv); safeSet('event','⚖️ PENALTY ! VAR confirme !');} safeSet(online?'varResult':'varResult1','✅ PENALTY ACCORDÉ !');
} else { safeSet(online?'varResult':'varResult1','❌ PAS PENALTY !'); }
}
setTimeout(()=>{if(el) el.classList.remove('active'); varBusy=false;},3000);
}catch(e){varBusy=false;}
},2000);
}catch(e){varBusy=false;}
}
