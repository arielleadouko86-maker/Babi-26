<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BABI 26</title><style>body{margin:0;font-family:Arial;background:#0a7a42;color:#fff;text-align:center}h1{font-size:44px}h1 span{color:#ffd700}.c{background:#fff;color:#111;margin:15px auto;max-width:400px;border-radius:20px;padding:20px}.b{display:flex;gap:10px;justify-content:center}button{border:0;border-radius:12px;padding:14px;font-size:18px;font-weight:bold} .g{background:#ffcc00}.m{background:#111;color:#fff}.d{background:#ff6b00;color:#fff}.r{background:#0a7a42;color:#fff;width:100%;margin-top:15px}#msg{font-size:20px;font-weight:bold;min-height:30px}</style></head><body><h1>BABI <span>26</span> ⚽</h1><p>Le jeu de foot d'Abidjan !</p><div class="c"><div>Score : <b id="s">0</b> / Essai : <b id="e">1</b>/5</div><div style="font-size:70px" id="goal">🥅</div><div id="msg">Choisis où tirer !</div><div class="b"><button class="g" onclick="t('gauche')">⬅️ Gauche</button><button class="m" onclick="t('centre')">⬆️ Centre</button><button class="d" onclick="t('droite')">➡️ Droite</button></div><button class="r" onclick="location.reload()">🔄 Rejouer</button></div><script>let s=0,e=1;function t(c){if(e>5)return;let g=['gauche','centre','droite'][Math.floor(Math.random()*3)];let m=document.getElementById('msg');let go=document.getElementById('goal');if(c===g){go.textContent='🧤';m.textContent='Arrêté !';m.style.color='red'}else{s++;go.textContent='⚽🎉';m.textContent='GOOOAL ! BABI 26 !';m.style.color='green'}document.getElementById('s').textContent=s;if(e===5){setTimeout(()=>{m.textContent=s>=3?'🏆 CHAMPION ! '+s+'/5 !':'Fin : '+s+'/5. Rejoue !'},500)}e++;if(e<=5)document.getElementById('e').textContent=e}</script></body></html>
